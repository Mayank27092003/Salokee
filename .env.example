# ============================================================
# SALON BOOKING PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your values
# ============================================================

# ─── APP ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME="Salon Booking Platform"
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/salon_booking_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/salon_booking_test?schema=public"

# ─── REDIS ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ─── JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_change_this
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=salon-booking-platform

# ─── SECURITY ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── EMAIL ──────────────────────────────────────────────────
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME="Salon Platform"
EMAIL_FROM_ADDRESS=noreply@salonplatform.com

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── COOKIE ─────────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_min_32_chars_change_this
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── LOGGING ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ─── STAGING/PRODUCTION OVERRIDES ───────────────────────────
# DATABASE_URL="postgresql://user:pass@prod-host:5432/salon_prod"
# NODE_ENV=production
# COOKIE_SECURE=true
# CORS_ORIGINS=https://yourdomain.com
